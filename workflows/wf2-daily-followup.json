      "parameters": {
        "jsCode": "const now = new Date();\nreturn $input.all().map(item => {\n  const r = item.json;\n  const created = new Date(String(r.CreatedAt).replace(' ', 'T'));\n  const days = Math.floor((now - created) / 86400000);\n  const stage = Number(r.FollowUpStage || 0);\n  let due = 0;\n  if (stage === 0 && days >= 1) due = 1;\n  else if (stage === 1 && days >= 3) due = 2;\n  else if (stage === 2 && days >= 7) due = 3;\n  return { json: { ...r, days, due } };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        592,
        -96
      ],
